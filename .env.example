# =============================================================================
# alchemyServer environment template - copy to `.env` and fill in as needed.
#
# LAYERING (lowest -> highest priority), same key names as the monorepo root
# registry (C:\Users\HP\full-back-end-server\.env.example):
#   1. this file's defaults / the inline ${KEY:default} in application.properties
#      (so this module runs standalone when cloned by itself)
#   2. the root `.env` - found via $MASTER_ENV_FILE, else ../.env - overrides
#      this module's own .env
#   3. real process environment variables (highest)
#
# Format rules: KEY=value, one per line, no quotes, no inline comments,
# forward slashes in paths (Spring reads this as a .properties file).
# =============================================================================

# ----- Server ------------------------------------------------------------
ALCHEMY_PORT=8080
SERVER_ADDRESS=0.0.0.0

# ----- Database (HSQLDB) --------------------------------------------------
# Format: jdbc:hsqldb:hsql://HOST:PORT/DATABASE
DATABASE_URL=jdbc:hsqldb:hsql://localhost:9002/mydb

# ----- CORS ----------------------------------------------------------------
# Exact origins, comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://alex-dyakin.com
# Wildcard patterns, comma-separated, no spaces.
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.alex-dyakin.com,http://*.playit.pub:*,http://*.with.playit.plus:*,http://*.gl.at.ply.gg:*,http://localhost:*,capacitor://localhost,https://localhost
# When set, also allow http://<host>:* automatically (see SecurityConfig).
LAN_HOST=
PLAYIT_HOST=
